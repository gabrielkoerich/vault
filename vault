#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"
CONFIG_DIR="${VAULT_CONFIG_DIR:-$HOME/.config/vault}"
PATHS_FILE="$CONFIG_DIR/paths"
SCAN_FILE="$CONFIG_DIR/scan.yml"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SETTINGS_FILE="$CONFIG_DIR/settings"
VAULT_FILE="${VAULT_FILE:-$HOME/.vault.tar.age}"
MANIFEST_FILE="${VAULT_FILE%.tar.age}-manifest"
VAULTS_DIR="${VAULTS_DIR:-$HOME/.vaults}"
KEYCHAIN_PREFIX="${KEYCHAIN_PREFIX:-gabrielkoerich/vault}"
KEYCHAIN_DELETE_CONFIRM="${KEYCHAIN_DELETE_CONFIRM:-yes}"

load_settings() {
  # shellcheck source=/dev/null
  [ -f "$SETTINGS_FILE" ] && source "$SETTINGS_FILE"
  DELETE_METHOD="${DELETE_METHOD:-trash}"
  ENV_SCAN_DIRS="${ENV_SCAN_DIRS:-$HOME}"
  EXCLUDE_PATHS="${EXCLUDE_PATHS:-}"
  VAULT_NO_ENV_SCAN="${VAULT_NO_ENV_SCAN:-0}"
}

is_excluded() {
  local p="$1"
  [ -z "$EXCLUDE_PATHS" ] && return 1
  local IFS=','
  for exc in $EXCLUDE_PATHS; do
    exc="$(eval echo "$exc")"
    [[ "$p" == "$exc" || "$p" == "$exc/"* ]] && return 0
  done
  return 1
}

usage() {
  cat <<EOF
vault $VERSION — lock down sensitive files with age encryption

usage:
  vault init        setup config and scan for sensitive files
  vault lockdown    encrypt and remove sensitive files from disk (--dry-run to preview)
  vault unlock      restore sensitive files from the encrypted vault
  vault create      create a named vault from explicit paths
  vault open        decrypt a named vault
  vault scan        scan for exposed secrets and update paths config
  vault status      show whether vault is locked or unlocked
  vault paths       list configured sensitive paths
  vault version     show version

config:
  $PATHS_FILE           paths to lock (one per line)
  $SCAN_FILE            paths to scan for secrets (editable)

EOF
}

check_deps() {
  local missing=()
  for cmd in "$@"; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo "error: missing dependencies: ${missing[*]}" >&2
    echo "install with: brew install ${missing[*]}" >&2
    exit 1
  fi
}

ensure_config() {
  if [ ! -f "$PATHS_FILE" ]; then
    echo "error: vault is not set up yet" >&2
    echo "run 'vault init' first" >&2
    exit 1
  fi
}

keychain_service_for() {
  local name="${1:-default}"
  echo "${KEYCHAIN_PREFIX}:${name}"
}

is_darwin() {
  [[ "$(uname)" == "Darwin" ]]
}

# security resolves the default keychain through $HOME. With $HOME faked, as the
# tests do, it puts up a modal dialog and blocks forever on a headless runner.
# Refuse to call it unless a keychain is actually there.
# macOS keychain, or libsecret on Linux
secret_backend() {
  if is_darwin; then
    echo "security"
  elif command -v secret-tool >/dev/null 2>&1; then
    echo "secret-tool"
  else
    echo "none"
  fi
}

keychain_available() {
  case "$(secret_backend)" in
    security)
      if [ -n "${VAULT_KEYCHAIN:-}" ]; then
        [ -f "$VAULT_KEYCHAIN" ]
        return
      fi
      [ -f "$HOME/Library/Keychains/login.keychain-db" ]
      ;;
    secret-tool) return 0 ;;
    *) return 1 ;;
  esac
}

# only true for a terminal we can actually open, age reads passphrases from /dev/tty
can_use_tty() {
  { exec 3</dev/tty && exec 3>&-; } 2>/dev/null
}

keychain_get() {
  local name="${1:-default}"
  keychain_available || return 1
  local service
  service="$(keychain_service_for "$name")"
  if [ "$(secret_backend)" = "secret-tool" ]; then
    secret-tool lookup service "$service" account "$USER" 2>/dev/null
  elif [ -n "${VAULT_KEYCHAIN:-}" ]; then
    security find-generic-password -a "$USER" -s "$service" -w "$VAULT_KEYCHAIN" 2>/dev/null
  else
    security find-generic-password -a "$USER" -s "$service" -w 2>/dev/null
  fi
}

keychain_set() {
  local name="${1:-default}"
  local passphrase="$2"
  keychain_available || return 1
  local service
  service="$(keychain_service_for "$name")"
  if [ "$(secret_backend)" = "secret-tool" ]; then
    # secret-tool reads the value from stdin, so it never lands in argv
    printf '%s' "$passphrase" | secret-tool store --label="vault: $service" service "$service" account "$USER"
  elif [ -n "${VAULT_KEYCHAIN:-}" ]; then
    security add-generic-password -a "$USER" -s "$service" -w "$passphrase" -U "$VAULT_KEYCHAIN" >/dev/null
  else
    security add-generic-password -a "$USER" -s "$service" -w "$passphrase" -U >/dev/null
  fi
}

keychain_delete() {
  local name="${1:-default}"
  keychain_available || return 1
  local service
  service="$(keychain_service_for "$name")"
  if [ "$(secret_backend)" = "secret-tool" ]; then
    secret-tool clear service "$service" account "$USER" 2>/dev/null || true
    return 0
  fi
  if security find-generic-password -a "$USER" -s "$service" ${VAULT_KEYCHAIN:+"$VAULT_KEYCHAIN"} >/dev/null 2>&1; then
    if [[ "$KEYCHAIN_DELETE_CONFIRM" == "yes" ]]; then
      read -p "delete keychain entry '$service'? (y/N) " -n 1 -r < /dev/tty
      echo "" > /dev/tty
      [[ ! $REPLY =~ ^[Yy]$ ]] && return 0
    fi
    security delete-generic-password -a "$USER" -s "$service" ${VAULT_KEYCHAIN:+"$VAULT_KEYCHAIN"} >/dev/null
  fi
}

# --- identity backend ------------------------------------------------------
# age has no non-interactive passphrase option, so vaults are encrypted to a
# generated identity whose secret lives in the keychain. With age-plugin-se
# installed the key sits in the Secure Enclave and decryption asks for a
# fingerprint.

passphrase_removed() {
  echo "error: passphrase mode was removed, vaults use a keychain identity now" >&2
  echo "use --recipient or --recipients-file for explicit keys" >&2
  exit 1
}

identity_kind() {
  # tests and machines without biometry force plain keys
  if [ -n "${VAULT_IDENTITY_KIND:-}" ]; then
    echo "$VAULT_IDENTITY_KIND"
    return 0
  fi
  if command -v age-plugin-se >/dev/null 2>&1; then
    echo "se"
  else
    echo "plain"
  fi
}

identity_generate() {
  local out="$1"
  if [ "$(identity_kind)" = "se" ]; then
    age-plugin-se keygen --access-control any-biometry -o "$out" >/dev/null 2>&1
  else
    age-keygen -o "$out" >/dev/null 2>&1
  fi
}

# the key line only, comments would confuse the keychain round trip
identity_secret_line() {
  grep -v -e '^#' -e '^$' "$1" | head -n 1
}

identity_to_file() {
  local secret="$1" out="$2"
  printf '%s\n' "$secret" > "$out"
  chmod 600 "$out"
}

recipient_for_secret() {
  local secret="$1" tmp recipient
  tmp="$(mktemp)"
  identity_to_file "$secret" "$tmp"
  if [[ "$secret" == AGE-PLUGIN-SE-* ]]; then
    recipient="$(age-plugin-se recipients -i "$tmp")"
  else
    recipient="$(age-keygen -y "$tmp")"
  fi
  rm -f "$tmp"
  printf '%s' "$recipient"
}

# reuses the stored identity when there is one, so a name keeps its key
ensure_identity_create() {
  local name="${1:-default}"
  local secret tmp
  secret="$(keychain_get "$name" || true)"
  if [ -n "$secret" ]; then
    printf '%s' "$secret"
    return 0
  fi
  keychain_available || {
    echo "error: no usable keychain (set VAULT_KEYCHAIN, or use --recipient/--recipients-file)" >&2
    exit 1
  }
  # age-keygen refuses an existing file, so generate into a fresh directory
  tmp="$(mktemp -d)"
  identity_generate "$tmp/id"
  secret="$(identity_secret_line "$tmp/id")"
  rm -rf "$tmp"
  if [ -z "$secret" ]; then
    echo "error: could not generate an identity" >&2
    exit 1
  fi
  keychain_set "$name" "$secret"
  printf '%s' "$secret"
}

ensure_identity_open() {
  local name="${1:-default}"
  local secret
  secret="$(keychain_get "$name" || true)"
  if [ -z "$secret" ]; then
    keychain_available && echo "no stored identity for '$(keychain_service_for "$name")', age will ask for a passphrase" >&2
    return 1
  fi
  printf '%s' "$secret"
}

is_self() {
  local p="$1"
  # skip vault's own config, the vault file, and the vault script
  [[ "$p" == "$CONFIG_DIR" || "$p" == "$CONFIG_DIR/"* ]] && return 0
  [[ "$p" == "$VAULTS_DIR" || "$p" == "$VAULTS_DIR/"* ]] && return 0
  [[ "$p" == "$VAULT_FILE" || "$p" == "$MANIFEST_FILE" ]] && return 0
  [[ "$p" == "$(command -v vault 2>/dev/null)" ]] && return 0
  return 1
}

read_paths() {
  load_settings
  local paths=()
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    local expanded
    expanded="$(eval echo "$line")"
    if [ -e "$expanded" ]; then
      if is_self "$expanded"; then
        echo "error: $line points to vault's own files — remove it from $PATHS_FILE" >&2
        exit 1
      fi
      paths+=("$expanded")
    fi
  done < "$PATHS_FILE"

  # optionally collect .env files
  local scan_dirs
  scan_dirs="$(eval echo "$ENV_SCAN_DIRS")"
  if [ "$VAULT_NO_ENV_SCAN" -eq 1 ]; then
    :
  else
    read -p "scan for .env files under $scan_dirs? (Y/n) " -n 1 -r < /dev/tty
    echo "" > /dev/tty
    if [[ ! $REPLY =~ ^[Nn]$ ]]; then
      while IFS= read -r envfile; do
        is_self "$envfile" && continue
        is_excluded "$envfile" && continue
        paths+=("$envfile")
      done < <(fd -t f -H --no-ignore -g '.env*' "$scan_dirs" 2>/dev/null)
    fi
  fi

  printf '%s\n' ${paths[@]+"${paths[@]}"}
}

cmd_init() {
  check_deps age fd rg

  if [ -f "$SETTINGS_FILE" ]; then
    echo "vault is already set up ($CONFIG_DIR)"
    echo "run 'vault scan' to update, or edit files in $CONFIG_DIR directly"
    return
  fi

  mkdir -p "$CONFIG_DIR"
  echo "setting up vault..."
  echo ""

  # delete method
  if command -v trash &>/dev/null; then
    read -p "use trash instead of rm for deletion? (Y/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Nn]$ ]]; then
      echo "DELETE_METHOD=rm" >> "$SETTINGS_FILE"
    else
      echo "DELETE_METHOD=trash" >> "$SETTINGS_FILE"
    fi
  else
    echo "DELETE_METHOD=rm" >> "$SETTINGS_FILE"
    echo "tip: install 'trash' for recoverable deletion (brew install trash)"
  fi
  echo ""

  # .env scan directories
  read -rp "directories to scan for .env files (default: \$HOME): " env_dirs
  if [ -z "$env_dirs" ]; then
    echo "ENV_SCAN_DIRS=\$HOME" >> "$SETTINGS_FILE"
  else
    echo "ENV_SCAN_DIRS=$env_dirs" >> "$SETTINGS_FILE"
  fi
  echo ""

  # excluded paths
  read -rp "paths to exclude from scanning (comma-separated, or blank for none): " excludes
  if [ -n "$excludes" ]; then
    echo "EXCLUDE_PATHS=$excludes" >> "$SETTINGS_FILE"
  fi
  echo ""

  # run scan
  cmd_scan
  echo ""
  echo "done. review your paths with 'vault paths', then run 'vault lockdown'."
  echo "config: $CONFIG_DIR"
}

cmd_lockdown() {
  check_deps age fd
  ensure_config

  local recipients=()
  local recipients_file=""
  local dry_run=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --recipient)
        recipients+=("${2:-}")
        shift 2
        ;;
      --recipients-file)
        recipients_file="${2:-}"
        shift 2
        ;;
      --passphrase|--pass|--passphrase-stdin|--generate-pass)
        passphrase_removed
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$recipients_file" ] && [ -n "${VAULT_RECIPIENTS_FILE:-}" ]; then
    recipients_file="$VAULT_RECIPIENTS_FILE"
  fi
  if [ -n "$recipients_file" ] && [ ! -f "$recipients_file" ]; then
    echo "error: recipients file not found: $recipients_file" >&2
    exit 1
  fi

  if [ -f "$VAULT_FILE" ]; then
    echo "error: $VAULT_FILE already exists — already locked? run 'vault unlock' first" >&2
    exit 1
  fi

  local paths=()
  while IFS= read -r line; do
    paths+=("$line")
  done < <(read_paths)

  if [ ${#paths[@]} -eq 0 ]; then
    echo "nothing to lock — no sensitive files found"
    exit 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "would lock ${#paths[@]} path(s):"
    printf '  %s\n' "${paths[@]}"
    echo ""
    echo "dry run — nothing encrypted, nothing removed"
    exit 0
  fi

  echo "locking ${#paths[@]} sensitive path(s):"
  printf '  %s\n' "${paths[@]}"

  # save manifest
  printf '%s\n' "${paths[@]}" > "$MANIFEST_FILE"

  # tar and encrypt with passphrase
  local tmp_tar
  tmp_tar="$(mktemp)"
  trap 'rm -f "$tmp_tar"' RETURN
  tar -cf "$tmp_tar" -P "${paths[@]}" 2> >(grep -v 'socket ignored' >&2)

  echo ""
  echo "WARNING: if you lose your passphrase, you will lose access to all locked files."
  echo ""
  if [ ${#recipients[@]} -gt 0 ] || [ -n "$recipients_file" ]; then
    local age_args=()
    if [ -n "$recipients_file" ]; then
      age_args+=("-R" "$recipients_file")
    fi
    if [ ${#recipients[@]} -gt 0 ]; then
      for r in "${recipients[@]}"; do
        [ -n "$r" ] && age_args+=("-r" "$r")
      done
    fi
    age -o "$VAULT_FILE" ${age_args[@]+"${age_args[@]}"} "$tmp_tar"
  elif keychain_available; then
    local secret recipient
    secret="$(ensure_identity_create "default")"
    recipient="$(recipient_for_secret "$secret")"
    age -r "$recipient" -o "$VAULT_FILE" "$tmp_tar"
  elif can_use_tty; then
    # no keyring, so age owns the prompt and vault stores nothing
    age -p -o "$VAULT_FILE" "$tmp_tar"
  else
    echo "error: no keyring and no terminal — use --recipient or --recipients-file" >&2
    exit 1
  fi
  rm -f "$tmp_tar"

  # verify before removing
  if [ ! -f "$VAULT_FILE" ]; then
    echo "error: vault not created, aborting — files are safe" >&2
    rm -f "$MANIFEST_FILE"
    exit 1
  fi

  # remove originals
  load_settings
  for p in "${paths[@]}"; do
    [ -e "$p" ] || [ -L "$p" ] || continue
    if [[ "$DELETE_METHOD" == "trash" ]] && command -v trash &>/dev/null; then
      trash "$p"
    else
      rm -rf "$p"
    fi
  done

  echo ""
  echo "locked. sensitive files encrypted to $VAULT_FILE"
  echo "run 'vault unlock' to restore"

  if [[ "$DELETE_METHOD" == "trash" ]]; then
    echo ""
    read -p "empty trash now? (y/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      if [[ "$(uname)" == "Darwin" ]]; then
        osascript -e 'tell application "Finder" to empty the trash'
      fi
      echo "trash emptied"
    fi
  fi
}

cmd_unlock() {
  check_deps age
  local keep_keychain=0
  local identity_files=()
  local identity_stdin=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --keep-keychain)
        keep_keychain=1
        shift
        ;;
      --identity-file)
        identity_files+=("${2:-}")
        shift 2
        ;;
      --identity-stdin)
        identity_stdin=1
        shift
        ;;
      --passphrase|--pass|--passphrase-stdin|--generate-pass)
        passphrase_removed
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "unknown option: $1" >&2
        exit 1
        ;;
    esac
  done
  if [ ! -f "$VAULT_FILE" ]; then
    echo "error: $VAULT_FILE not found — not locked?" >&2
    exit 1
  fi

  local tmp_tar
  tmp_tar="$(mktemp)"
  trap 'rm -f "$tmp_tar"' RETURN
  local identity_tmp=""
  if [ -z "${VAULT_IDENTITY_FILE:-}" ] || [ ${#identity_files[@]} -gt 0 ] || [ "$identity_stdin" -eq 1 ]; then
    : # identity_files already set
  else
    identity_files+=("$VAULT_IDENTITY_FILE")
  fi

  if [ "$identity_stdin" -eq 1 ]; then
    identity_tmp="$(mktemp)"
    cat > "$identity_tmp"
    identity_files+=("$identity_tmp")
  fi

  if [ ${#identity_files[@]} -gt 0 ]; then
    for id in ${identity_files[@]+"${identity_files[@]}"}; do
      if [ ! -f "$id" ]; then
        echo "error: identity file not found: $id" >&2
        exit 1
      fi
    done
    local age_args=()
    for id in "${identity_files[@]}"; do
      [ -n "$id" ] && age_args+=("-i" "$id")
    done
    age --decrypt -o "$tmp_tar" ${age_args[@]+"${age_args[@]}"} "$VAULT_FILE"
  else
    local secret idfile
    if secret="$(ensure_identity_open "default")"; then
      idfile="$(mktemp)"
      identity_to_file "$secret" "$idfile"
      age --decrypt -i "$idfile" -o "$tmp_tar" "$VAULT_FILE"
      rm -f "$idfile"
    else
      age --decrypt -o "$tmp_tar" "$VAULT_FILE"
    fi
  fi
  tar -xf "$tmp_tar" -P -C "$HOME"
  rm -f "$tmp_tar"
  [ -n "$identity_tmp" ] && rm -f "$identity_tmp"

  rm -f "$VAULT_FILE" "$MANIFEST_FILE"
  if [ "$keep_keychain" -eq 0 ]; then
    keychain_delete "default" || true
  fi
  echo "unlocked. all sensitive files restored"
}

cmd_create() {
  check_deps age

  local recipients=()
  local recipients_file=""
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --recipient) recipients+=("${2:-}"); shift 2 ;;
      --recipients-file) recipients_file="${2:-}"; shift 2 ;;
      --) shift; break ;;
      --passphrase|--pass|--passphrase-stdin|--generate-pass) passphrase_removed ;;
      -h|--help) usage; exit 0 ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done

  local name="${1:-}"
  shift || true

  if [ -z "$name" ]; then
    echo "error: vault name is required" >&2
    exit 1
  fi

  # Allow flags after the vault name too (e.g. vault create myname --recipients-file ...)
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --recipient) recipients+=("${2:-}"); shift 2 ;;
      --recipients-file) recipients_file="${2:-}"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  if [ $# -eq 0 ]; then
    echo "error: provide at least one path to lock" >&2
    exit 1
  fi

  mkdir -p "$VAULTS_DIR"
  local vault_file="$VAULTS_DIR/$name.tar.age"
  local manifest_file="$VAULTS_DIR/$name-manifest"

  if [ -f "$vault_file" ]; then
    echo "error: $vault_file already exists — already locked? run 'vault open $name' first" >&2
    exit 1
  fi

  local paths=()
  for raw in "$@"; do
    local expanded
    expanded="$(eval echo "$raw")"
    if [ ! -e "$expanded" ]; then
      echo "error: path not found: $raw" >&2
      exit 1
    fi
    if is_self "$expanded"; then
      echo "error: $raw points to vault's own files — choose another path" >&2
      exit 1
    fi
    # absolutize
    if [[ "$expanded" != /* ]]; then
      expanded="$(cd "$(dirname "$expanded")" && pwd)/$(basename "$expanded")"
    fi
    paths+=("$expanded")
  done

  if [ -z "$recipients_file" ] && [ -n "${VAULT_RECIPIENTS_FILE:-}" ]; then
    recipients_file="$VAULT_RECIPIENTS_FILE"
  fi
  if [ -n "$recipients_file" ] && [ ! -f "$recipients_file" ]; then
    echo "error: recipients file not found: $recipients_file" >&2
    exit 1
  fi
  echo "locking ${#paths[@]} path(s) to named vault '$name':"
  printf '  %s\n' "${paths[@]}"

  printf '%s\n' "${paths[@]}" > "$manifest_file"

  local tmp_tar
  tmp_tar="$(mktemp)"
  trap 'rm -f "$tmp_tar"' RETURN
  tar -cf "$tmp_tar" -P "${paths[@]}" 2> >(grep -v 'socket ignored' >&2)

  echo ""
  echo "WARNING: if you lose your passphrase, you will lose access to this vault."
  echo ""


  if [ ${#recipients[@]} -gt 0 ] || [ -n "$recipients_file" ]; then
    local age_args=()
    if [ -n "$recipients_file" ]; then
      age_args+=("-R" "$recipients_file")
    fi
    if [ ${#recipients[@]} -gt 0 ]; then
      for r in "${recipients[@]}"; do
        [ -n "$r" ] && age_args+=("-r" "$r")
      done
    fi
    age -o "$vault_file" ${age_args[@]+"${age_args[@]}"} "$tmp_tar"
  elif keychain_available; then
    local secret recipient
    secret="$(ensure_identity_create "$name")"
    recipient="$(recipient_for_secret "$secret")"
    age -r "$recipient" -o "$vault_file" "$tmp_tar"
  elif can_use_tty; then
    # no keyring, so age owns the prompt and vault stores nothing
    age -p -o "$vault_file" "$tmp_tar"
  else
    echo "error: no keyring and no terminal — use --recipient or --recipients-file" >&2
    exit 1
  fi
  rm -f "$tmp_tar"

  if [ ! -f "$vault_file" ]; then
    echo "error: vault not created, aborting — files are safe" >&2
    rm -f "$manifest_file"
    exit 1
  fi

  load_settings
  for p in "${paths[@]}"; do
    [ -e "$p" ] || [ -L "$p" ] || continue
    if [[ "$DELETE_METHOD" == "trash" ]] && command -v trash &>/dev/null; then
      trash "$p"
    else
      rm -rf "$p"
    fi
  done

  echo ""
  echo "locked. named vault saved to $vault_file"
  echo "run 'vault open $name' to restore"
}

cmd_open() {
  check_deps age

  local keep_keychain=0
  local identity_files=()
  local identity_stdin=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --keep-keychain)
        keep_keychain=1
        shift
        ;;
      --identity-file)
        identity_files+=("${2:-}")
        shift 2
        ;;
      --identity-stdin)
        identity_stdin=1
        shift
        ;;
      --)
        shift
        break
        ;;
      --passphrase|--pass|--passphrase-stdin|--generate-pass)
        passphrase_removed
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  local name="${1:-}"
  shift || true

  if [ -z "$name" ]; then
    echo "error: vault name is required" >&2
    exit 1
  fi

  # Allow flags after the vault name too (e.g. vault open myname --identity-file ...)
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --keep-keychain) keep_keychain=1; shift ;;
      --identity-file) identity_files+=("${2:-}"); shift 2 ;;
      --identity-stdin) identity_stdin=1; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  local vault_file="$VAULTS_DIR/$name.tar.age"
  local manifest_file="$VAULTS_DIR/$name-manifest"
  if [ ! -f "$vault_file" ]; then
    echo "error: $vault_file not found — not locked?" >&2
    exit 1
  fi

  local tmp_tar
  tmp_tar="$(mktemp)"
  trap 'rm -f "$tmp_tar"' RETURN

  local identity_tmp=""
  if [ -z "${VAULT_IDENTITY_FILE:-}" ] || [ ${#identity_files[@]} -gt 0 ] || [ "$identity_stdin" -eq 1 ]; then
    : # identity_files already set
  else
    identity_files+=("$VAULT_IDENTITY_FILE")
  fi

  if [ "$identity_stdin" -eq 1 ]; then
    identity_tmp="$(mktemp)"
    cat > "$identity_tmp"
    identity_files+=("$identity_tmp")
  fi

  if [ ${#identity_files[@]} -gt 0 ]; then
    for id in ${identity_files[@]+"${identity_files[@]}"}; do
      if [ ! -f "$id" ]; then
        echo "error: identity file not found: $id" >&2
        exit 1
      fi
    done
    local age_args=()
    for id in "${identity_files[@]}"; do
      [ -n "$id" ] && age_args+=("-i" "$id")
    done
    age --decrypt -o "$tmp_tar" ${age_args[@]+"${age_args[@]}"} "$vault_file"
  else
    local secret idfile
    if secret="$(ensure_identity_open "$name")"; then
      idfile="$(mktemp)"
      identity_to_file "$secret" "$idfile"
      age --decrypt -i "$idfile" -o "$tmp_tar" "$vault_file"
      rm -f "$idfile"
    else
      age --decrypt -o "$tmp_tar" "$vault_file"
    fi
  fi
  tar -xf "$tmp_tar" -P
  rm -f "$tmp_tar"
  [ -n "$identity_tmp" ] && rm -f "$identity_tmp"

  rm -f "$vault_file" "$manifest_file"
  if [ "$keep_keychain" -eq 0 ]; then
    keychain_delete "$name" || true
  fi
  echo "unlocked. named vault '$name' restored"
}

cmd_scan() {
  check_deps fd rg
  load_settings
  mkdir -p "$CONFIG_DIR"
  touch "$PATHS_FILE"

  # copy default scan.yml if user doesn't have one
  if [ ! -f "$SCAN_FILE" ]; then
    local default_scan="$SCRIPT_DIR/scan.yml"
    # homebrew installs to share/vault/
    [ ! -f "$default_scan" ] && default_scan="$(brew --prefix 2>/dev/null)/share/vault/scan.yml"
    if [ -f "$default_scan" ]; then
      cp "$default_scan" "$SCAN_FILE"
      echo "created $SCAN_FILE from defaults"
      echo "edit it to customize what vault scans for"
      echo ""
    else
      echo "error: no scan.yml found" >&2
      exit 1
    fi
  fi

  local found=0
  add_path() {
    local p="$1"
    local label="$2"
    local entry="$p"
    [[ "$p" == "$HOME/"* ]] && entry="\$HOME/${p#"$HOME"/}"
    if ! rg -qxF "$entry" "$PATHS_FILE"; then
      echo "$entry" >> "$PATHS_FILE"
      echo "  added: $entry ($label)"
      found=$((found + 1))
    fi
  }

  echo "scanning for exposed secrets..."

  # check paths from scan.yml
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    local raw="${line#- }"
    raw="${raw%%#*}"        # strip inline comments
    raw="${raw%"${raw##*[![:space:]]}"}"  # trim trailing whitespace
    local expanded
    expanded="$(eval echo "$raw")"
    if [ -e "$expanded" ] && ! is_excluded "$expanded"; then
      add_path "$expanded" "scan.yml"
    fi
  done < "$SCAN_FILE"

  # scan shell files for exported secrets
  for f in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -f "$f" ] && rg -qi '(API_KEY|SECRET|TOKEN|PASSWORD|PRIVATE_KEY)=' "$f" 2>/dev/null; then
      add_path "$f" "secrets in shell config"
    fi
  done

  # scan for .env files
  local scan_dirs
  scan_dirs="$(eval echo "$ENV_SCAN_DIRS")"
  while IFS= read -r envfile; do
    is_excluded "$envfile" && continue
    add_path "$envfile" ".env file"
  done < <(fd -t f -H --no-ignore -g '.env*' "$scan_dirs" 2>/dev/null || true)

  # scan for private key files
  while IFS= read -r keyfile; do
    local dir
    dir="$(dirname "$keyfile")"
    add_path "$dir" "private key found"
  done < <(rg -l --glob '*.pem' --glob '*.key' --glob '*.p12' 'PRIVATE KEY' "$HOME/.config" "$HOME/.local" 2>/dev/null || true)

  if [ "$found" -eq 0 ]; then
    echo "no new paths found — vault config is up to date"
  else
    echo ""
    echo "added $found new path(s) to $PATHS_FILE"
  fi
}

cmd_status() {
  if [ -f "$VAULT_FILE" ]; then
    echo "locked"
    if [ -f "$MANIFEST_FILE" ]; then
      echo ""
      echo "encrypted paths:"
      sed 's/^/  /' "$MANIFEST_FILE"
    fi
  else
    echo "unlocked"
  fi
}

cmd_paths() {
  ensure_config
  echo "configured paths ($PATHS_FILE):"
  echo ""
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    local expanded
    expanded="$(eval echo "$line")"
    if [ -e "$expanded" ]; then
      echo "  $line"
    else
      echo "  $line (missing)"
    fi
  done < "$PATHS_FILE"
}

case "${1:-}" in
  init|setup) cmd_init ;;
  lockdown|lock) shift; cmd_lockdown "$@" ;;
  unlock) shift; cmd_unlock "$@" ;;
  create) shift; cmd_create "$@" ;;
  open) shift; cmd_open "$@" ;;
  scan) cmd_scan ;;
  status) cmd_status ;;
  paths) cmd_paths ;;
  version|-v|--version) echo "vault $VERSION" ;;
  help|-h|--help|"") usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
